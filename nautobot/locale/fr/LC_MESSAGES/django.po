msgstr "Markdown personnalisé ou HTML limité à afficher dans une bannière en haut de toutes les pages."

#: nautobot/core/settings.py:861
msgid ""
"Number of days to retain object changelog history.\n"
"Set this to 0 to retain changes indefinitely."
msgstr ""

#: nautobot/core/settings.py:869
msgid ""
"Select how Devices are uniquely identified:\n"
"- 'location_tenant_name': combination of Location + Tenant + Name\n"
"- 'name': Device name must be globally unique\n"
"- 'none': No enforced uniqueness (rely on other validation rules or custom validators)"
msgstr ""

#: nautobot/core/settings.py:880
msgid ""
"Randomly generated UUID used to identify this installation.\n"
"Used for sending anonymous installation metrics, when settings.INSTALLATION_METRICS_ENABLED is set to True."
msgstr ""

#: nautobot/core/settings.py:888
msgid "Maximum size (in bytes) of any single file generated by a <code>Job.create_file()</code> call."
msgstr "Taille maximale (en octets) de tout fichier généré par un appel à <code>Job.create_file()</code>."

#: nautobot/core/settings.py:896
msgid ""
"Default <code>max_depth</code> filter value to use for Location list views (0 for no filter).\n"
"Setting this to a small value may improve performance when the number of records is large."
msgstr ""
"Valeur par défaut du filtre <code>max_depth</code> pour les vues liste de sites (0 pour aucun filtre).\n"
"Une petite valeur peut améliorer les performances lorsque le nombre d'enregistrements est important."

#: nautobot/core/settings.py:905
msgid "Location names are not guaranteed globally-unique by Nautobot but in practice they often are. Set this to True to use the location name alone as the natural key for Location objects. Set this to False to use the sequence (name, parent__name, parent__parent__name, ...) as the natural key instead."
msgstr "Nautobot ne garantit pas l'unicité globale des noms de site, bien qu'ils le soient souvent en pratique. Définissez cette valeur sur True pour utiliser le seul nom du site comme clé naturelle des objets Location. Définissez-la sur False pour utiliser à la place la séquence (name, parent__name, parent__parent__name, ...)."

#: nautobot/core/settings.py:915
msgid ""
"Maximum number of objects that a user can list in one UI page or one API call.\n"
"If set to 0, a user can retrieve an unlimited number of objects."
msgstr ""

#: nautobot/core/settings.py:922
msgid "Default number of objects to display per page when listing objects in the UI and/or REST API."
msgstr "Nombre d'objets affichés par page par défaut lors du listage dans l'interface et/ou l'API REST."

#: nautobot/core/settings.py:928
msgid ""
"Pagination options to present to the user to choose amongst.\n"
"For proper user experience, this list should include the PAGINATE_COUNT and MAX_PAGE_SIZE values as options."
msgstr ""

#: nautobot/core/settings.py:938
msgid ""
"Enable a default <code>type=container</code> filter on Prefix list views.\n"
"Enabling this may improve performance when the number of records is large."
msgstr ""
"Activer un filtre <code>type=container</code> par défaut sur les vues liste de préfixes.\n"
"L'activer peut améliorer les performances lorsque le nombre d'enregistrements est important."

#: nautobot/core/settings.py:948
msgid ""
"Default <code>max_depth</code> filter value to use for Prefix list views (0 for no filter).\n"
"Setting this to a small value may improve performance when the number of records is large."
msgstr ""
"Valeur par défaut du filtre <code>max_depth</code> pour les vues liste de préfixes (0 pour aucun filtre).\n"
"Une petite valeur peut améliorer les performances lorsque le nombre d'enregistrements est important."

#: nautobot/core/settings.py:958
msgid ""
"Extend or override default Platform.network_driver translations provided by <a href=\"https://netutils.readthedocs.io/en/latest/user/lib_use_cases_lib_mapper/\">netutils</a>. Enter a dictionary in JSON format, for example:\n"
"<pre><code class=\"language-json\">{\n"
"    \"netmiko\": {\"my_network_driver\": \"cisco_ios\"},\n"
"    \"pyats\": {\"my_network_driver\": \"iosxe\"} \n"
"}</code></pre>"
msgstr ""
"Étendre ou remplacer les correspondances Platform.network_driver par défaut fournies par <a href=\"https://netutils.readthedocs.io/en/latest/user/lib_use_cases_lib_mapper/\">netutils</a>. Saisissez un dictionnaire au format JSON, par exemple :\n"
"<pre><code class=\"language-json\">{\n"
"    \"netmiko\": {\"my_network_driver\": \"cisco_ios\"},\n"
"    \"pyats\": {\"my_network_driver\": \"iosxe\"} \n"
"}</code></pre>"

#: nautobot/core/settings.py:973
msgid "Expiration date for an active Nautobot support contract with Network to Code. This value is displayed in the About page to provide additional support information."
msgstr "Date d'expiration d'un contrat de support Nautobot actif avec Network to Code. Cette valeur est affichée sur la page À propos afin de fournir des informations de support supplémentaires."

#: nautobot/core/settings.py:980
msgid "Whether to prefer IPv4 primary addresses over IPv6 primary addresses for devices."
msgstr "Indique s'il faut préférer les adresses IPv4 principales aux adresses IPv6 principales pour les équipements."

#: nautobot/core/settings.py:985
msgid "Default height in rack units (U) for newly created racks. Must be between 1 and 500."
msgstr "Hauteur par défaut en unités de rack (U) pour les nouveaux racks. Doit être comprise entre 1 et 500."

#: nautobot/core/settings.py:989
msgid "Default height (in pixels) of a rack unit in a rack elevation diagram"
msgstr "Hauteur par défaut (en pixels) d'une unité de rack dans un schéma d'élévation"

#: nautobot/core/settings.py:992
msgid "Default width (in pixels) of a rack unit in a rack elevation diagram"
msgstr "Largeur par défaut (en pixels) d'une unité de rack dans un schéma d'élévation"

#: nautobot/core/settings.py:996
msgid "Enables two-digit format for the rack unit numbering in a rack elevation diagram"
msgstr "Active le format à deux chiffres pour la numérotation des unités dans le schéma d'élévation"

#: nautobot/core/settings.py:1002
msgid "Number of seconds (must be at least 3600, or one hour) to cache the result of a release check before checking again for a new release."
msgstr "Nombre de secondes (au moins 3600, soit une heure) pendant lesquelles le résultat d'une vérification de version est mis en cache avant une nouvelle vérification."

#: nautobot/core/settings.py:1011
msgid ""
"URL of GitHub repository REST API endpoint to poll periodically for availability of new Nautobot releases.\n"
"This can be set to the official repository \"https://api.github.com/repos/nautobot/nautobot/releases\" or a custom fork.\n"
"Set this to an empty string to disable automatic update checks."
msgstr ""

#: nautobot/core/settings.py:1021
msgid ""
"Help message to include on 4xx and 5xx error pages. Markdown is supported, as are some HTML tags and attributes.\n"
"If unspecified, instructions to join Network to Code's Slack community will be provided."
msgstr ""

